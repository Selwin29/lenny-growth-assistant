# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

# --- General ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# PostgreSQL is required from Milestone 3 onward.
# e.g. postgresql+psycopg2://user:password@localhost:5432/lenny_growth_assistant
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenny_growth_assistant

# --- LLM Provider ---
# One of: ollama | openai | anthropic (used by future milestones)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
# Generation/read timeout for local inference (seconds).
# llama3.1:8b on CPU can take 60-240 s; set higher if you still see timeouts.
OLLAMA_TIMEOUT=300
# Connection timeout — fail fast if Ollama isn't running.
OLLAMA_CONNECT_TIMEOUT=10
# Maximum words per RAG chunk sent to the LLM (keeps the prompt manageable).
RAG_CHUNK_WORD_LIMIT=400
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
