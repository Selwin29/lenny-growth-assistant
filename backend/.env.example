# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

# --- General ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite for local dev, e.g.: postgresql+psycopg2://user:password@localhost:5432/lenny_growth_assistant
DATABASE_URL=sqlite:///./lenny_growth_assistant.db

# --- LLM Provider ---
# One of: ollama | openai | anthropic (used by future milestones)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
