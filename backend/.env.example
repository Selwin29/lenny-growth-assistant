# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file.

# --- General ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# PostgreSQL is required from Milestone 3 onward.
# e.g. postgresql+psycopg2://user:password@localhost:5432/lenny_growth_assistant
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenny_growth_assistant

# --- LLM Provider ---
# One of: gemini | anthropic | ollama
LLM_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Generation/read timeout for local inference (seconds).
OLLAMA_TIMEOUT=300
OLLAMA_CONNECT_TIMEOUT=10

# Maximum words per RAG chunk sent to the LLM (keeps the prompt manageable).
RAG_CHUNK_WORD_LIMIT=300

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenny_growth_assistant

